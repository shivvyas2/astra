# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Daily dosha alerts (/api/cron/alerts). Vercel sends this as a bearer token on
# scheduled invocations; without it the route refuses every request.
CRON_SECRET=

# APNs (developer.apple.com → Certificates, Identifiers & Profiles → Keys).
# Leave blank locally: alerts are still written, pushes are skipped.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.shivvyas.astra
# Contents of the .p8 file. Keep the BEGIN/END lines; \n escapes are accepted.
APNS_PRIVATE_KEY=
