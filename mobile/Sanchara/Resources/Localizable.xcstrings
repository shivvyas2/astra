          }
        }
      }
    },
    "Deleting removes your chart, readings, and alerts permanently.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કાઢી નાખવાથી તમારી કુંડળી, ફળાદેશ અને અલર્ટ કાયમ માટે નીકળી જાય છે."
