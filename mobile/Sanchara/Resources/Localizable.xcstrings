    "Readings need this": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફળાદેશ માટે આ જરૂરી છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फलादेश के लिए यह ज़रूरी है"
