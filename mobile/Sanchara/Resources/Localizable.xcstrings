          }
        }
      }
    },
    "Your kundli draws from the chart we computed at sign-up. If this stays empty, check your connection and pull down or tap Try again.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી કુંડળી સાઇન અપ વખતે બનેલા ચાર્ટ પરથી આવે છે. જો આ ખાલી રહે, તો તમારું ઇન્ટરનેટ તપાસો અને નીચે ખેંચો અથવા ફરી પ્રયાસ કરો પર ટૅપ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कुंडली साइन अप के समय बने चार्ट से आती है। अगर यह खाली रहे, तो अपना इंटरनेट देखें और नीचे खींचें या फिर कोशिश करें पर टैप करें।"
          }
        }
      }
    },
    "Your life": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું જીવન"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका जीवन"
          }
        }
      }
    },
    "Your life in dasha periods. Pin what happened and the readings sharpen.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દશાઓમાં તમારું જીવન. જે બન્યું તે ઉમેરો, ફળાદેશ વધુ સચોટ બનશે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दशाओं में आपका जीवन। जो हुआ उसे जोड़ें, फलादेश और सटीक होंगे।"
          }
