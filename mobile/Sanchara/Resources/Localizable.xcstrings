          }
        }
      }
    },
    "Which transit is shaping the next three months for me?": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કયો ગોચર મારા આવતા ત્રણ મહિના ઘડી રહ્યો છે?"
          }
