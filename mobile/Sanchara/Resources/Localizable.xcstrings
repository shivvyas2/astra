    },
    "Supportive and challenging follow classical gochara, counted from your Moon. Computed, not predicted: a reading says what a date is likely to mean for you.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શુભ અને કઠિન પરંપરાગત ગોચર મુજબ છે, તમારા ચંદ્ર પરથી ગણેલાં. આ ગણતરી છે, ભવિષ્યવાણી નહીં: કોઈ તારીખ તમારા માટે શું અર્થ રાખી શકે, એ ફળાદેશ કહે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुभ और कठिन पारंपरिक गोचर के हिसाब से हैं, आपके चंद्र से गिने गए। यह गणना है, भविष्यवाणी नहीं: कोई तारीख आपके लिए क्या मतलब रख सकती है, यह फलादेश बताता है।"
          }
        }
      }
    },
    "Surya (Sun sign)": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂર્ય રાશિ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूर्य राशि"
          }
        }
      }
    },
    "Tabs": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટૅબ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैब"
          }
        }
      }
    },
    "Tap to read": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વાંચવા ટૅપ કરો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ने के लिए टैप करें"
          }
        }
      }
    },
    "Tap your photo at the top of Ask: birth details, photo, and your account.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂછો ઉપર તમારા ફોટા પર ટૅપ કરો: જન્મની વિગતો, ફોટો અને તમારું ખાતું."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूछें के ऊपर अपनी फ़ोटो पर टैप करें: जन्म विवरण, फ़ोटो और आपका खाता।"
          }
        }
      }
    },
    "Tell Astrya about your life in a reading (your job, relationships, plans) and it'll remember here. You can delete anything.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ ફળાદેશમાં Astryaને તમારા જીવન વિશે કહો (કામ, સંબંધો, યોજનાઓ), તે અહીં યાદ રાખશે. તમે કંઈ પણ કાઢી શકો છો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी फलादेश में Astrya को अपने जीवन के बारे में बताएँ (काम, रिश्ते, योजनाएँ), वह यहाँ याद रखेगा। आप कुछ भी हटा सकते हैं।"
          }
        }
      }
    },
    "Tell me more about this: %@. %@ What should I watch for, and what can I do about it?": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આના વિશે વધુ કહો: %@. %@ મારે શેનું ધ્યાન રાખવું જોઈએ, અને હું એ માટે શું કરી શકું?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बारे में और बताइए: %@। %@ मुझे किस बात का ध्यान रखना चाहिए, और मैं इसके लिए क्या कर सकता हूँ?"
          }
        }
      }
    },
    "Terms of Use": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપયોગની શરતો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोग की शर्तें"
          }
        }
      }
    },
    "Terms of use": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપયોગની શરતો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोग की शर्तें"
          }
        }
      }
    },
    "Thank you": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આભાર"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धन्यवाद"
          }
        }
      }
    },
    "Thank you for supporting Astrya. Manage or cancel here.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Astryaને સાથ આપવા બદલ આભાર. અહીં સંભાળો કે રદ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Astrya का साथ देने के लिए धन्यवाद। यहाँ संभालें या रद्द करें।"
          }
        }
      }
    },
    "Thank you. You're on Plus.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આભાર. તમે Plus પર છો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धन्यवाद। आप Plus पर हैं।"
          }
        }
      }
    },
    "That code didn't work. It may have expired, so send a new one.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ કોડ ચાલ્યો નહીં. કદાચ તેની મુદત પૂરી થઈ ગઈ છે, નવો કોડ મોકલો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोड नहीं चला। शायद इसकी समय-सीमा खत्म हो गई है, नया कोड भेजें।"
          }
        }
      }
    },
    "That day": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એ જ દિવસે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसी दिन"
          }
        }
      }
    },
    "That didn't save. Try again.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સેવ થયું નહીં. ફરી પ્રયાસ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सेव नहीं हुआ। फिर कोशिश करें।"
          }
        }
      }
    },
    "That email doesn't look right.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ઈમેલ બરાબર લાગતો નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ईमेल सही नहीं लग रहा।"
          }
        }
      }
    },
    "That image could not be read. Try another.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટો ખૂલી શક્યો નહીં. બીજો પસંદ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोटो खुल नहीं सकी। कोई दूसरी चुनें।"
          }
        }
      }
    },
    "That link has expired. Request a new one.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ લિંકની મુદત પૂરી થઈ ગઈ છે. નવી લિંક મંગાવો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लिंक की समय-सीमा खत्म हो गई है। नया लिंक मँगाएँ।"
          }
        }
      }
    },
    "That month": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એ જ મહિને"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसी महीने"
          }
        }
      }
    },
    "That one needs a full reading. I've saved the question. Open Astrya and it's ready to ask.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ માટે આખું ફળાદેશ જોઈએ. મેં સવાલ સેવ કરી લીધો છે. Astrya ખોલો, સવાલ પૂછવા માટે તૈયાર છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लिए पूरा फलादेश चाहिए। मैंने सवाल सेव कर लिया है। Astrya खोलें, सवाल पूछने के लिए तैयार है।"
          }
        }
      }
    },
    "That request could not be built.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ વિનંતી બની શકી નહીં."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अनुरोध बन नहीं सका।"
          }
        }
      }
    },
    "That year": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એ જ વર્ષે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसी साल"
          }
        }
      }
    },
    "The Astrya mark in lime, violet or bone on your home screen. Change it any time under You → App icon.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી હોમ સ્ક્રીન પર Astryaનું નિશાન લાઇમ, જાંબલી કે ક્રીમ રંગમાં. તેને ગમે ત્યારે તમે → ઍપ આઇકન માં બદલો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी होम स्क्रीन पर Astrya का निशान लाइम, बैंगनी या क्रीम रंग में। इसे कभी भी आप → ऐप आइकन में बदलें।"
          }
        }
      }
    },
    "The Astrya team can read conversations and what Astrya remembers, to fix problems and keep readings safe.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તકલીફો સુધારવા અને ફળાદેશ સુરક્ષિત રાખવા માટે Astryaની ટીમ વાતચીત અને Astryaને યાદ રહેલી વાતો વાંચી શકે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिक्कतें ठीक करने और फलादेश सुरक्षित रखने के लिए Astrya की टीम बातचीत और Astrya की याद रखी बातें पढ़ सकती है।"
          }
        }
      }
    },
    "The Moon moved from %@ into %@ that day, so even the Moon sign depends on the hour.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તે દિવસે ચંદ્ર %@ માંથી %@ માં ગયો, એટલે ચંદ્ર રાશિ પણ જન્મના કલાક પર આધાર રાખે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस दिन चंद्र %@ से %@ में गया, इसलिए चंद्र राशि भी जन्म के घंटे पर निर्भर है।"
          }
        }
      }
    },
    "The Moon stayed in %@ all day, so the Moon sign is certain.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચંદ્ર આખો દિવસ %@ માં રહ્યો, એટલે ચંદ્ર રાશિ નક્કી છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चंद्र पूरे दिन %@ में रहा, इसलिए चंद्र राशि पक्की है।"
          }
        }
      }
    },
    "The Moon's sign sits in the top diamond, and each house after it is counted from the Moon. The numeral in each is its rashi, counted from Mesha.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચંદ્રની રાશિ ઉપરના હીરામાં છે, અને પછીનો દરેક ભાવ ચંદ્રથી ગણેલો છે. દરેક ભાવમાં લખેલો અંક તેની રાશિ છે, મેષથી ગણેલો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चंद्र की राशि ऊपर वाले हीरे में है, और उसके बाद हर भाव चंद्र से गिना गया है। हर भाव में लिखा अंक उसकी राशि है, मेष से गिना हुआ।"
          }
        }
      }
    },
    "The app, your readings, alerts and notifications all use this language. Sanskrit terms keeps English but uses Surya, Mesha, bhava and so on.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ, તમારા ફળાદેશ, અલર્ટ અને સૂચનાઓ, બધું આ ભાષામાં હશે. Sanskrit terms માં અંગ્રેજી રહે છે, પણ સૂર્ય, મેષ, ભાવ જેવા શબ્દો વપરાય છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप, आपके फलादेश, अलर्ट और सूचनाएँ, सब इसी भाषा में होंगे। Sanskrit terms में अंग्रेज़ी रहती है, पर सूर्य, मेष, भाव जैसे शब्द इस्तेमाल होते हैं।"
          }
        }
      }
    },
    "The chapter of your life you are in now, and how far through it you are.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા જીવનનો એ અધ્યાય જેમાં તમે હમણાં છો, અને તમે એમાં કેટલા આગળ છો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जीवन का वह अध्याय जिसमें आप अभी हैं, और आप उसमें कितना आगे हैं।"
          }
        }
      }
    },
    "The chart below is counted from the Moon, so houses are “from the Moon” rather than from the ascendant.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નીચેની કુંડળી ચંદ્રથી ગણી છે, એટલે ભાવ લગ્નથી નહીં, “ચંદ્રથી” છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे की कुंडली चंद्र से गिनी गई है, इसलिए भाव लग्न से नहीं, “चंद्र से” हैं।"
          }
        }
      }
    },
    "The eight kootas": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આઠ કૂટ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आठ कूट"
          }
        }
      }
    },
    "The facts from your computed chart this reading rests on.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ગણાયેલી કુંડળીની એ હકીકતો જેના પર આ ફળાદેશ આધારિત છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी बनाई गई कुंडली के वे तथ्य जिन पर यह फलादेश टिका है।"
          }
        }
      }
    },
    "The icon didn't change. Try again.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આઇકન બદલાયું નહીં. ફરી પ્રયાસ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइकन नहीं बदला। फिर कोशिश करें।"
          }
        }
      }
    },
    "The line under each chapter is written for you from your own chart and from the moments you have pinned. It is a reading of what that chapter tends to ask of you, not a prediction of events. Past chapters are read in hindsight; future ones as tendencies.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક અધ્યાય નીચેની લીટી તમારી પોતાની કુંડળી અને તમે ઉમેરેલી પળો પરથી તમારા માટે લખાય છે. એ કહે છે કે એ અધ્યાય તમારી પાસેથી સામાન્ય રીતે શું માગે છે, એ ઘટનાઓની ભવિષ્યવાણી નથી. વીતેલા અધ્યાયો પાછળ વળીને વંચાય છે, આવનારા વલણ તરીકે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर अध्याय के नीचे की पंक्ति आपकी अपनी कुंडली और आपके जोड़े गए पलों से आपके लिए लिखी जाती है। यह बताती है कि वह अध्याय आपसे अक्सर क्या चाहता है, यह घटनाओं की भविष्यवाणी नहीं है। बीते अध्याय पीछे मुड़कर पढ़े जाते हैं, आने वाले झुकाव की तरह।"
          }
        }
      }
    },
    "The newest dosha or hard transit starting or ending in your chart.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી કુંડળીમાં શરૂ કે પૂરો થતો સૌથી નવો દોષ કે કઠિન ગોચર."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कुंडली में शुरू या खत्म हो रहा सबसे नया दोष या कठिन गोचर।"
          }
        }
      }
    },
    "The purchase didn't go through. You haven't been charged.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખરીદી પૂરી ન થઈ. તમારી પાસેથી કોઈ પૈસા લેવાયા નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदारी पूरी नहीं हुई। आपसे कोई पैसा नहीं लिया गया।"
          }
        }
      }
    },
    "The questions you ask and the conversation so far.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે પૂછેલા સવાલ અને અત્યાર સુધીની વાતચીત."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पूछे सवाल और अब तक की बातचीत।"
          }
        }
      }
    },
    "The reading Astrya wrote for you this morning or tonight, and any new alert.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Astrya એ આજે સવારે કે આજે રાત્રે તમારા માટે લખેલું ફળાદેશ, અને કોઈ નવો અલર્ટ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Astrya ने आज सुबह या आज रात आपके लिए जो फलादेश लिखा, और कोई नया अलर्ट।"
          }
        }
      }
    },
    "The reading ended before it began.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફળાદેશ શરૂ થતાં પહેલાં જ અટકી ગયું."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फलादेश शुरू होने से पहले ही रुक गया।"
          }
        }
      }
    },
    "The server has no APNs key, so it sends nothing. Set the APNS_* variables on Vercel.": {
      "shouldTranslate": false
    },
    "The stars are unreachable right now.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હમણાં તારાઓ સુધી પહોંચી શકાતું નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी सितारों तक पहुँच नहीं हो पा रही।"
          }
        }
      }
    },
    "The year ahead, to the day": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આવનારું વર્ષ, દિવસ મુજબ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आने वाला साल, दिन के हिसाब से"
          }
        }
      }
    },
    "Their birth details and chart are deleted. Readings about the two of you stay in your history.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તેમની જન્મની વિગતો અને કુંડળી કાઢી નખાશે. તમારા બંને વિશેના ફળાદેશ તમારી જૂની વાતચીતમાં રહેશે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उनका जन्म विवरण और कुंडली हट जाएगी। आप दोनों के बारे में फलादेश आपकी पिछली बातचीत में रहेंगे।"
          }
        }
      }
    },
    "There's no reading yet. Astrya writes one each morning and night.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજી કોઈ ફળાદેશ નથી. Astrya દર સવારે અને રાત્રે એક લખે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई फलादेश नहीं है। Astrya हर सुबह और रात एक लिखता है।"
          }
        }
      }
    },
    "They are your": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તેઓ તમારા છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे आपके हैं"
          }
        }
      }
    },
    "Thinking of what to ask next…": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હવે શું પૂછવું તે વિચારી રહ્યા છીએ…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोच रहे हैं कि आगे क्या पूछें…"
          }
        }
      }
    },
    "Thinking of what to ask…": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું પૂછવું તે વિચારી રહ્યા છીએ…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोच रहे हैं कि क्या पूछें…"
          }
        }
      }
    },
    "This device can't change the app icon.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ડિવાઇસ ઍપ આઇકન બદલી શકતું નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस ऐप आइकन नहीं बदल सकता।"
          }
        }
      }
    },
    "This device doesn't support Apple Intelligence": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોન Apple Intelligence સપોર્ટ કરતો નથી"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोन Apple Intelligence सपोर्ट नहीं करता"
          }
        }
      }
    },
    "This permanently removes your chart, readings, and alerts. It cannot be undone.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આનાથી તમારી કુંડળી, ફળાદેશ અને અલર્ટ કાયમ માટે નીકળી જશે. તે પાછું કરી શકાશે નહીં."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आपकी कुंडली, फलादेश और अलर्ट हमेशा के लिए हट जाएँगे। इसे वापस नहीं किया जा सकता।"
          }
        }
      }
    },
    "Those dates couldn't be read. Try again.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ તારીખો વાંચી શકાઈ નહીં. ફરી પ્રયાસ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये तारीखें पढ़ी नहीं जा सकीं। फिर कोशिश करें।"
          }
        }
      }
    },
    "Three more app icons": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ત્રણ વધુ ઍપ આઇકન"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन और ऐप आइकन"
          }
        }
      }
    },
    "Time of birth": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
