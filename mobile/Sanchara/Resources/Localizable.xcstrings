    },
    "Turn on Apple Intelligence in Settings to enable": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચાલુ કરવા માટે સેટિંગ્સમાં Apple Intelligence ઑન કરો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू करने के लिए सेटिंग्स में Apple Intelligence ऑन करें"
          }
        }
      }
    },
    "Turn on notifications": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂચનાઓ ચાલુ કરો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ चालू करें"
          }
        }
      }
    },
    "Unavailable on this device": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોન પર ઉપલબ્ધ નથી"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन पर उपलब्ध नहीं"
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પાછું લો"
          }
        },
        "hi": {
