    "Ask about today now": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજ વિશે હમણાં પૂછો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के बारे में अभी पूछें"
          }
        }
      }
    },
    "Ask about work, love, money, a decision, a year. Every answer is read from your real birth chart, not your Sun sign.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કામ, પ્રેમ, પૈસા, કોઈ નિર્ણય કે આખું વર્ષ, કંઈ પણ પૂછો. દરેક જવાબ તમારી સાચી જન્મ કુંડળી પરથી વંચાય છે, ફક્ત સૂર્ય રાશિ પરથી નહીં."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम, प्यार, पैसा, कोई फ़ैसला या पूरा साल, कुछ भी पूछें। हर जवाब आपकी असली जन्म कुंडली से पढ़ा जाता है, सिर्फ़ सूर्य राशि से नहीं।"
          }
        }
      }
    },
    "Ask about you and %@…": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા અને %@ વિશે પૂછો…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने और %@ के बारे में पूछें…"
          }
        }
      }
    },
    "Ask anything. Every answer is read from your real birth chart.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંઈ પણ પૂછો. દરેક જવાબ તમારી સાચી કુંડળીમાંથી વાંચવામાં આવે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी पूछें। हर जवाब आपकी असली कुंडली से पढ़ा जाता है।"
          }
        }
      }
    },
    "Ask for a full reading": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂરો ફળાદેશ માંગો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा फलादेश माँगें"
          }
        }
      }
    },
    "Ask what's ahead this month": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂછો કે આ મહિને શું આવવાનું છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूछें कि इस महीने क्या आने वाला है"
          }
        }
      }
    },
    "Ask. %@ Ask about work, love, money, a decision, a year. Every answer is read from your real birth chart, not your Sun sign.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂછો. %@ કામ, પ્રેમ, પૈસા, કોઈ નિર્ણય કે આખું વર્ષ, કંઈ પણ પૂછો. દરેક જવાબ તમારી સાચી જન્મ કુંડળી પરથી વંચાય છે, ફક્ત સૂર્ય રાશિ પરથી નહીં."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूछें। %@ काम, प्यार, पैसा, कोई फ़ैसला या पूरा साल, कुछ भी पूछें। हर जवाब आपकी असली जन्म कुंडली से पढ़ा जाता है, सिर्फ़ सूर्य राशि से नहीं।"
          }
        }
      }
    },
    "Asks this question": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સવાલ પૂછે છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सवाल पूछता है"
          }
        }
      }
    },
    "Astrya": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Astrya"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Astrya"
          }
        }
      }
    },
    "Astrya Plus member": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Astrya Plus સભ્ય"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Astrya Plus सदस्य"
          }
        }
      }
    },
    "Astrya needs permission to add events. Turn it on in Settings, Astrya, Calendars.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઇવેન્ટ ઉમેરવા માટે Astrya ને પરવાનગી જોઈએ. તેને સેટિંગ્સ, Astrya, કેલેન્ડરમાં ચાલુ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इवेंट जोड़ने के लिए Astrya को अनुमति चाहिए। इसे सेटिंग्स, Astrya, कैलेंडर में चालू करें।"
          }
        }
      }
    },
    "Astrya will no longer know any of this in your readings. It can't be undone.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ફળાદેશમાં Astryaને હવે આમાંથી કંઈ ખબર નહીં રહે. તે પાછું કરી શકાશે નહીં."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके फलादेशों में Astrya को अब इनमें से कुछ भी पता नहीं रहेगा। इसे वापस नहीं किया जा सकता।"
          }
        }
      }
    },
    "Astrya's readings are written by an AI model made by Anthropic. To write one, your details have to be sent to it. Here is exactly what goes where.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Astryaનાં ફળાદેશ Anthropicએ બનાવેલા AI મોડેલથી લખાય છે. ફળાદેશ લખવા માટે તમારી વિગતો તેને મોકલવી પડે છે. અહીં સ્પષ્ટ જણાવ્યું છે કે શું ક્યાં જાય છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Astrya के फलादेश Anthropic के बनाए AI मॉडल से लिखे जाते हैं। फलादेश लिखने के लिए आपकी जानकारी उसे भेजनी पड़ती है। यहाँ साफ़-साफ़ बताया है कि क्या कहाँ जाता है।"
          }
        }
      }
    },
    "Astrya's record": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Astryaનો રેકોર્ડ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Astrya का रिकॉर्ड"
          }
        }
      }
    },
