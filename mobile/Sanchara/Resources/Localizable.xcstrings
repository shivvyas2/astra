      }
    },
    "Apple sign-in didn't complete. Try again.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple સાથે સાઇન ઇન પૂરું થયું નહીં. ફરી પ્રયાસ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple से साइन इन पूरा नहीं हुआ। फिर कोशिश करें।"
          }
        }
      }
    },
    "As close as you know. A wrong hour moves the ascendant.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જેટલું ચોક્કસ ખબર હોય એટલું. ખોટા કલાકથી લગ્ન બદલાઈ જાય છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जितना सही पता हो उतना। गलत घंटे से लग्न बदल जाता है।"
          }
        }
      }
    },
    "Ascendant uncertain: birth time unknown": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લગ્ન નક્કી નથી: જન્મ સમય ખબર નથી"
          }
        },
        "hi": {
