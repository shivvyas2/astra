        }
      }
    },
    "Readings need your OK to send your chart to Anthropic.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફળાદેશ માટે તમારી કુંડળી Anthropicને મોકલવા તમારી મંજૂરી જોઈએ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फलादेश के लिए आपकी कुंडली Anthropic को भेजने की आपकी मंज़ूरी चाहिए।"
          }
        }
      }
    },
    "Readings pause until you agree again. Nothing already stored is deleted; use What Astrya knows or Delete account for that.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ફરી સંમતિ ન આપો ત્યાં સુધી ફળાદેશ અટકી જશે. જે પહેલેથી સાચવેલું છે તે કાઢી નખાશે નહીં; તે માટે 'Astrya શું જાણે છે' અથવા 'ખાતું કાઢી નાખો' વાપરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप फिर से सहमति न दें, फलादेश रुके रहेंगे। जो पहले से सहेजा है वह नहीं हटेगा; उसके लिए 'Astrya क्या जानता है' या 'खाता हटाएँ' का इस्तेमाल करें।"
          }
        }
      }
    },
    "Readings per day": {
      "shouldTranslate": false
    },
    "Readings stay free. Plus helps pay for them.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફળાદેશ મફત રહે છે. Plus તેનો ખર્ચ ચૂકવવામાં મદદ કરે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फलादेश मुफ़्त रहते हैं। Plus उनका खर्च उठाने में मदद करता है।"
          }
        }
      }
    },
    "Reads back the Vimshottari mahadasha and antardasha you are running.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ચાલુ વિંશોત્તરી મહાદશા અને અંતર્દશા વાંચી સંભળાવે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी चल रही विंशोत्तरी महादशा और अंतर्दशा पढ़कर सुनाता है।"
          }
        }
      }
    },
    "Reads back the most recent reading written for you.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા માટે લખાયેલું સૌથી નવું ફળાદેશ વાંચી સંભળાવે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके लिए लिखा गया सबसे नया फलादेश पढ़कर सुनाता है।"
          }
        }
