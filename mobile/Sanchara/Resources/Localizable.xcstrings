          }
        }
      }
    },
    "On iPhones with Apple Intelligence, some answers and notes are made by Apple's on-device model. That stays on your phone.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ધરાવતા iPhone પર કેટલાક જવાબ અને નોંધો ફોનમાં જ ચાલતા Appleના મોડેલથી બને છે. તે તમારા ફોનમાં જ રહે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence वाले iPhone पर कुछ जवाब और नोट फ़ोन में ही चलने वाले Apple के मॉडल से बनते हैं। वह सब आपके फ़ोन में ही रहता है।"
          }
        }
      }
    },
    "On your mind": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મનની વાતો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मन की बातें"
          }
        }
      }
    },
    "On, generating suggestions on this device": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચાલુ છે, આ જ ફોન પર સૂચનો બનાવે છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू है, इसी फ़ोन पर सुझाव बना रहा है"
          }
        }
      }
    },
    "One email, one password, and we'll build your real birth chart next.": {
      "localizations": {
        "gu": {
          "stringUnit": {
