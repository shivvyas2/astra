    "Today": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज"
          }
        }
      }
    },
    "Today's reading": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજનું ફળાદેશ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का फलादेश"
          }
        }
      }
    },
    "Today, %@. A reading every morning and night, written from today's sky and your chart. Alerts come only when a dosha or hard transit starts or ends.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજ, %@. દર સવારે અને રાત્રે એક ફળાદેશ, આજના આકાશ અને તમારી કુંડળી પરથી લખેલું. અલર્ટ ત્યારે જ આવે છે જ્યારે કોઈ દોષ કે કઠિન ગોચર શરૂ કે પૂરો થાય."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज, %@। हर सुबह और रात एक फलादेश, आज के आसमान और आपकी कुंडली से लिखा हुआ। अलर्ट तभी आते हैं जब कोई दोष या कठिन गोचर शुरू या खत्म होता है।"
          }
        }
      }
    },
    "Total %@, average %@ a day": {
      "shouldTranslate": false
    },
    "Transit": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગોચર"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गोचर"
          }
        }
      }
    },
    "Travel": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રવાસ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यात्रा"
          }
        }
      }
    },
    "Tropical chart with Placidus houses": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાયન કુંડળી, પ્લેસિડસ ભાવો સાથે"
          }
        },
        "hi": {
