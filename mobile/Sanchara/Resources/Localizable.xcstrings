    },
    "Answers a question about your kundli on this device.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી કુંડળી વિશેના સવાલનો જવાબ આ જ ડિવાઇસ પર આપે છે."
          }
