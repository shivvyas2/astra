    },
    "Usage, cost, people and their readings.": {
      "shouldTranslate": false
    },
    "Use a different email": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બીજો ઈમેલ વાપરો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरा ईमेल इस्तेमाल करें"
          }
        }
      }
    },
    "Vedic": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૈદિક"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैदिक"
          }
        }
      }
    },
    "Vedic astrology divides a life into a fixed sequence of chapters, each ruled by one planet. The sequence is called Vimshottari dasha. Which chapter you were born into depends on where the Moon was at the moment of your birth, and everything after follows in order.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૈદિક જ્યોતિષ જીવનને અધ્યાયોના એક નક્કી ક્રમમાં વહેંચે છે, દરેક અધ્યાયનો સ્વામી એક ગ્રહ હોય છે. આ ક્રમને વિંશોત્તરી દશા કહે છે. તમે કયા અધ્યાયમાં જન્મ્યા, એ તમારા જન્મ સમયે ચંદ્ર ક્યાં હતો તેના પર આધાર રાખે છે, અને પછી બધું ક્રમમાં આવે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैदिक ज्योतिष जीवन को अध्यायों के एक तय क्रम में बाँटता है, हर अध्याय का स्वामी एक ग्रह होता है। इस क्रम को विंशोत्तरी दशा कहते हैं। आप किस अध्याय में पैदा हुए, यह इस पर निर्भर है कि आपके जन्म के समय चंद्र कहाँ था, और उसके बाद सब कुछ क्रम से आता है।"
          }
        }
      }
    },
    "View your kundli": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી કુંડળી જુઓ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कुंडली देखें"
          }
        }
      }
    },
    "Vimshottari dasha": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિંશોત્તરી દશા"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विंशोत्तरी दशा"
          }
        }
      }
    },
    "Vimshottari dasha periods from birth onward. Pin what really happened and the readings get sharper.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જન્મથી આગળની વિંશોત્તરી દશાઓ. જે ખરેખર થયું એ ઉમેરો, ફળાદેશ વધુ ચોક્કસ થતાં જશે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जन्म से आगे की विंशोत्तरी दशाएँ। जो सच में हुआ उसे जोड़ें, फलादेश और सटीक होते जाएँगे।"
          }
        }
      }
    },
    "Violet": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જાંબલી"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैंगनी"
          }
        }
      }
    },
    "Waiting for approval. Plus starts once it's approved.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મંજૂરીની રાહ છે. મંજૂરી મળતાં જ Plus શરૂ થશે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मंज़ूरी का इंतज़ार है। मंज़ूरी मिलते ही Plus शुरू होगा।"
          }
        }
      }
    },
    "Waiting for your answer": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા જવાબની રાહ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जवाब का इंतज़ार"
          }
        }
      }
    },
    "Warning": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચેતવણી"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेतावनी"
          }
        }
      }
    },
    "We sent a %lld-digit code to %@.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અમે %2$@ પર %1$lld અંકનો કોડ મોકલ્યો છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने %2$@ पर %1$lld अंकों का कोड भेजा है।"
          }
        }
      }
    },
    "We'll use noon and avoid anything that depends on the exact hour: their ascendant, houses and the Moon's exact degree. You can add the time later.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અમે બપોરના 12 વાગ્યાનો સમય લઈશું અને ચોક્કસ કલાક પર આધારિત બાબતો છોડી દઈશું: તેમનું લગ્ન, ભાવ અને ચંદ્રનો ચોક્કસ અંશ. સમય તમે પછી ઉમેરી શકો છો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम दोपहर 12 बजे का समय लेंगे और सही घंटे पर टिकी चीज़ें छोड़ देंगे: उनका लग्न, भाव और चंद्रमा का सही अंश। समय आप बाद में जोड़ सकते हैं।"
          }
        }
      }
    },
    "We'll use noon and avoid anything that depends on the exact hour: your ascendant, houses and the Moon's exact degree. You can add the time later.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અમે બપોરના 12 વાગ્યાનો સમય લઈશું અને ચોક્કસ કલાક પર આધારિત બાબતો છોડી દઈશું: તમારું લગ્ન, ભાવ અને ચંદ્રનો ચોક્કસ અંશ. સમય તમે પછી ઉમેરી શકો છો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम दोपहर 12 बजे का समय लेंगे और सही घंटे पर टिकी चीज़ें छोड़ देंगे: आपका लग्न, भाव और चंद्रमा का सही अंश। समय आप बाद में जोड़ सकते हैं।"
          }
        }
      }
    },
    "Welcome back": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફરી સ્વાગત છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से स्वागत है"
          }
        }
      }
    },
    "Western": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પશ્ચિમી"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पश्चिमी"
          }
        }
      }
    },
    "Western synastry": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પશ્ચિમી મેળાપ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पश्चिमी मिलान"
          }
        }
      }
    },
    "What Astrya knows": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Astrya શું જાણે છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Astrya क्या जानता है"
          }
        }
      }
    },
    "What are these periods?": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ દશાઓ શું છે?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये दशाएँ क्या हैं?"
          }
        }
      }
    },
    "What do my strongest placements say I should do with them?": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મારા સૌથી મજબૂત ગ્રહ-સ્થાન શું કહે છે, મારે તેનો શું ઉપયોગ કરવો જોઈએ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरे सबसे मज़बूत ग्रह-स्थान क्या कहते हैं, मुझे उनका क्या करना चाहिए?"
          }
        }
      }
    },
    "What do you want to know?": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે શું જાણવા માંગો છો?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप क्या जानना चाहते हैं?"
          }
        }
      }
    },
    "What does my %@ house (%@) say about %@?": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મારો %@ ભાવ (%@) %@ વિશે શું કહે છે?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरा %@ भाव (%@) %@ के बारे में क्या कहता है?"
          }
        }
      }
    },
    "What does my personal year ask of me, month by month?": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મારું વ્યક્તિગત વર્ષ મહિને-મહિને મારી પાસે શું માંગે છે?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरा निजी वर्ष महीने-दर-महीने मुझसे क्या चाहता है?"
          }
        }
      }
    },
    "What does today's sky mean for me? Read it from my chart.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજનું આકાશ મારા માટે શું કહે છે? મારી કુંડળી પરથી કહો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का आसमान मेरे लिए क्या कहता है? मेरी कुंडली से बताइए।"
          }
        }
      }
    },
    "What each tab is for, in a minute.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક ટૅબ શેના માટે છે, એક મિનિટમાં."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर टैब किस काम का है, एक मिनट में।"
          }
        }
      }
    },
    "What happened?": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું થયું હતું?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या हुआ था?"
          }
        }
      }
    },
    "What is kept, and where": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું રખાય છે, અને ક્યાં"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या रखा जाता है, और कहाँ"
          }
        }
      }
    },
    "What is sent": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું મોકલાય છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या भेजा जाता है"
          }
        }
      }
    },
    "What is the one thing in my chart I should act on this year?": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મારી કુંડળીમાં એવી કઈ એક વાત છે જેના પર મારે આ વર્ષે કામ કરવું જોઈએ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरी कुंडली में वह एक बात क्या है जिस पर मुझे इस साल काम करना चाहिए?"
          }
        }
      }
    },
    "What readings send, what's kept, and how to withdraw.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફળાદેશ શું મોકલે છે, શું રખાય છે, અને સંમતિ કેવી રીતે પાછી ખેંચવી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फलादेश क्या भेजते हैं, क्या रखा जाता है, और सहमति कैसे वापस लें।"
          }
        }
      }
    },
    "What the meanings are": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ અર્થ શું છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये मतलब क्या हैं"
          }
        }
      }
    },
    "What the periods are": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દશા એટલે શું"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दशा क्या होती है"
          }
        }
      }
    },
    "What these periods are": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ દશાઓ શું છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये दशाएँ क्या हैं"
          }
        }
      }
    },
    "What transits are coming up for me this month, and what should I watch for?": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ મહિને મારા માટે કયા ગોચર આવી રહ્યા છે, અને મારે શેનું ધ્યાન રાખવું જોઈએ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस महीने मेरे लिए कौन से गोचर आ रहे हैं, और मुझे किस बात का ध्यान रखना चाहिए?"
          }
        }
      }
    },
    "What you've told Astrya, what you talked about, and what it predicted. Every reading uses it.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે Astryaને શું કહ્યું, શેના વિશે વાત કરી, અને તેણે શું ભવિષ્ય કહ્યું. દરેક ફળાદેશમાં આ વપરાય છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने Astrya को क्या बताया, किस बारे में बात की, और उसने क्या भविष्यवाणी की। हर फलादेश में इसका इस्तेमाल होता है।"
          }
        }
      }
    },
    "What's shared with Anthropic": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic સાથે શું શેર થાય છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic के साथ क्या साझा होता है"
          }
        }
      }
    },
    "What's where": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું ક્યાં છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या कहाँ है"
          }
        }
      }
    },
    "When": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્યારે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कब"
          }
        }
      }
    },
    "When a dosha or a hard transit starts or ends in your chart, an alert lands here the same day. Until then, quiet is good news.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે તમારી કુંડળીમાં કોઈ દોષ કે કઠિન ગોચર શરૂ કે પૂરો થશે, એ જ દિવસે અહીં અલર્ટ આવશે. ત્યાં સુધી શાંતિ એ સારા સમાચાર છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपकी कुंडली में कोई दोष या कठिन गोचर शुरू या खत्म होगा, उसी दिन यहाँ अलर्ट आएगा। तब तक शांति अच्छी खबर है।"
          }
        }
      }
    },
    "When a reading names a window, Astrya keeps it. Once the dates arrive, tell it what happened. After %lld answers, its score with you shows here.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે કોઈ ફળાદેશ કોઈ સમયગાળો કહે છે, Astrya તેને યાદ રાખે છે. એ તારીખો આવે ત્યારે તેને કહો કે શું થયું. %lld જવાબો પછી તમારી સાથેનો તેનો સ્કોર અહીં દેખાશે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई फलादेश कोई समय बताता है, Astrya उसे याद रखता है। वह समय आने पर उसे बताएँ कि क्या हुआ। %lld जवाबों के बाद आपके साथ उसका स्कोर यहाँ दिखेगा।"
          }
        }
      }
    },
    "When does my current dasha period end, and what changes then?": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મારી હાલની દશા ક્યારે પૂરી થશે, અને ત્યારે શું બદલાશે?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरी अभी की दशा कब खत्म होगी, और तब क्या बदलेगा?"
          }
        }
      }
    },
    "When is a good window to make a big decision?": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ મોટો નિર્ણય લેવાનો સારો સમય ક્યારે છે?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई बड़ा फ़ैसला लेने का अच्छा समय कब है?"
          }
        }
      }
    },
    "When it said “likely”": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે તેણે “સંભવિત” કહ્યું"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
