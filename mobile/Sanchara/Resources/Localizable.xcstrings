        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी निजता नीति पढ़ें"
          }
        }
      }
    },
    "Read with the Moon at noon in your birthplace's time zone. Classical muhurta, computed from your chart.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા જન્મ સ્થળના સમય મુજબ બપોરના ચંદ્ર પરથી વાંચ્યું છે. પરંપરાગત મુહૂર્ત, તમારી કુંડળી પરથી ગણેલું."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जन्म स्थान के समय के हिसाब से दोपहर के चंद्र से पढ़ा गया। पारंपरिक मुहूर्त, आपकी कुंडली से निकाला गया।"
          }
        }
      }
    },
    "Read your chart as the groom's": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી કુંડળીને વરની કુંડળી ગણીને વાંચો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कुंडली को वर की कुंडली मानकर पढ़ें"
          }
        }
      }
    },
    "Read your stars,\n": {
      "localizations": {
