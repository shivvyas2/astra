          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नहीं पढ़ा"
          }
        }
      }
    },
    "Update my details": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મારી વિગતો અપડેટ કરો"
