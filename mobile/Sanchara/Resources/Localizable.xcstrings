          }
        }
      }
    },
    "Every reading is free, Deep readings included. Plus is a way to keep it that way.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક ફળાદેશ મફત છે, Deep ફળાદેશ પણ. Plus તેને એવું જ રાખવાનો એક રસ્તો છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर फलादेश मुफ़्त है, Deep फलादेश भी। Plus इसे ऐसा ही बनाए रखने का एक तरीका है।"
          }
        }
      }
    },
    "Every reading is written by Anthropic's model from your chart and your question, so Astrya can't read for you without sending them. Nothing has been sent. Come back to this whenever you're ready.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક ફળાદેશ Anthropicનું મોડેલ તમારી કુંડળી અને તમારા સવાલ પરથી લખે છે, એટલે તે મોકલ્યા વગર Astrya તમારા માટે ફળાદેશ લખી શકતું નથી. હજી કંઈ મોકલાયું નથી. તમે તૈયાર હો ત્યારે અહીં પાછા આવો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर फलादेश Anthropic का मॉडल आपकी कुंडली और आपके सवाल से लिखता है, इसलिए इन्हें भेजे बिना Astrya आपके लिए फलादेश नहीं लिख सकता। अभी कुछ नहीं भेजा गया है। जब आप तैयार हों, यहाँ लौट आएँ।"
          }
        }
      }
    },
    "Every reading you ask for is saved here the moment you send your first question, with its mode and date.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જે પણ ફળાદેશ માંગો, પહેલો સવાલ મોકલતાં જ તે અહીં તેના મોડ અને તારીખ સાથે સેવ થઈ જાય છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो भी फलादेश माँगते हैं, पहला सवाल भेजते ही वह यहाँ अपने मोड और तारीख के साथ सेव हो जाता है।"
          }
        }
      }
    },
    "Every sign change, station and sub-period in the next twelve months, computed from the ephemeris and read against your chart. Readings quote these dates.": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આવતા બાર મહિનામાં દરેક રાશિ બદલાવ, ગ્રહનું થંભવું અને અંતર્દશા, પંચાંગ પરથી ગણેલાં અને તમારી કુંડળી મુજબ વાંચેલાં. ફળાદેશ આ જ તારીખોનો ઉલ્લેખ કરે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले बारह महीनों में हर राशि बदलाव, ग्रह का ठहराव और अंतर्दशा, पंचांग से निकाली गई और आपकी कुंडली के हिसाब से पढ़ी गई। फलादेश इन्हीं तारीखों का ज़िक्र करते हैं।"
          }
        }
      }
    },
    "Everything you've asked": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જે કંઈ પૂછ્યું"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने जो कुछ भी पूछा"
          }
        }
      }
    },
    "Export as PDF": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF તરીકે મોકલો"
