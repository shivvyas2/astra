        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर कोशिश करें"
          }
        }
      }
    },
    "Try asking": {
      "localizations": {
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ પૂછી જુઓ"
